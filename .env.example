# ── Loxone MCP Proxy configuration ───────────────────────────────
# Copy this file to ".env" and fill in your values.
#
# Your Miniserver serial number = its MAC address without colons.
# Find it at http://<miniserver-ip>/jdev/cfg/api  (field "snr"),
# or in Loxone Config. Example: 50:4F:94:A1:AE:7A -> 504F94A1AE7A
LOXONE_SERIAL=504F94A1AE7A

# The Loxone user the assistant logs in as.
# STRONGLY RECOMMENDED: create a DEDICATED user with only the rights
# the assistant needs (e.g. read-only), so a mistake stays contained.
LOXONE_USER=mcp
LOXONE_PASSWORD=change-me

# ── Optional ─────────────────────────────────────────────────────
# Loxone Cloud "connect" base (stable entry point that redirects to
# the current relay). Rarely needs changing.
# LOXONE_CONNECT_BASE=https://connect.loxonecloud.com

# Where to cache the OAuth tokens (defaults to ~/.loxone-mcp-proxy/cache.json)
# LOXONE_CACHE_PATH=

# Loopback port used only as the OAuth redirect target (never actually
# opened — the code is captured from the redirect). Change on conflict.
# LOXONE_REDIRECT_PORT=41678

# Set to 1 for verbose logging on stderr.
# LOXONE_DEBUG=0
